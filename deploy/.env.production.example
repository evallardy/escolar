# Copiar a /var/www/escolar/.env en el servidor y llenar con valores reales.
# NUNCA subir este archivo con datos reales al repositorio.

DJANGO_SECRET_KEY=genera-una-clave-nueva-con-get_random_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=escolar.iagmexico.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://escolar.iagmexico.com

# MySQL en producción
DB_ENGINE=mysql
DB_NAME=escolar
DB_USER=escolar_app
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=127.0.0.1
DB_PORT=3306

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
