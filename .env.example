# Copia este archivo a .env y ajusta los valores para tu entorno local.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-con-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=mysql usa MySQL (requiere servidor y credenciales reales).
# DB_ENGINE=sqlite permite validar el proyecto sin servidor MySQL disponible (solo desarrollo).
DB_ENGINE=sqlite
DB_NAME=escolar
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
